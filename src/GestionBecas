import java.util.ArrayList;
import java.util.Collections;
import java.util.Comparator;
import java.util.List;


public class GestorBecas {
    private List<Estudiante> estudiantes;
    private Beca beca;
    private boolean asignacionRealizada;

    public GestorBecas(Beca beca) {
        if (beca == null) {
            throw new IllegalArgumentException("La beca no puede ser nula.");
        }
        this.beca = beca;
        this.estudiantes = new ArrayList<>();
        this.asignacionRealizada = false;
    }

    public Beca getBeca() {
        return beca;
    }

    public List<Estudiante> getEstudiantes() {
        return Collections.unmodifiableList(estudiantes);
    }

    public boolean isAsignacionRealizada() {
        return asignacionRealizada;
    }

    // ---------- 1. Registro ----------

    public Estudiante buscarEstudiante(String codigo) {
        if (codigo == null) {
            return null;
        }
        String c = codigo.trim().toUpperCase();
        for (Estudiante e : estudiantes) {
            if (e.getCodigo().equals(c)) {
                return e;
            }
        }
        return null;
    }

    public Estudiante registrarEstudiante(String codigo, String nombre) {
        Estudiante nuevo = new Estudiante(codigo, nombre); // valida vacíos
        if (buscarEstudiante(nuevo.getCodigo()) != null) {
            throw new IllegalStateException("Ya existe un estudiante con el código " + nuevo.getCodigo() + ".");
        }
        estudiantes.add(nuevo);
        invalidarAsignacion();
        return nuevo;
    }

    public void registrarEvaluacion(String codigo, String nombreEvaluacion, double nota) {
        Estudiante e = buscarEstudiante(codigo);
        if (e == null) {
            throw new IllegalStateException("No existe un estudiante con el código " + codigo + ".");
        }
        e.agregarEvaluacion(new Evaluacion(nombreEvaluacion, nota)); // valida nota 0-10
        invalidarAsignacion();
    }

    // ---------- 2. Promedios y elegibilidad ----------

    public double calcularPromedio(String codigo) {
        Estudiante e = buscarEstudiante(codigo);
        if (e == null) {
            throw new IllegalStateException("No existe un estudiante con el código " + codigo + ".");
        }
        return e.calcularPromedio();
    }

    public boolean esElegible(Estudiante e) {
        return beca.esElegible(e);
    }

    // ---------- 3. Ranking ----------

       public List<Estudiante> obtenerRankingElegibles() {
        List<Estudiante> ranking = new ArrayList<>();
        for (Estudiante e : estudiantes) {
            if (beca.esElegible(e)) {
                ranking.add(e);
            }
        }
        ranking.sort(new Comparator<Estudiante>() {
            @Override
            public int compare(Estudiante a, Estudiante b) {
                double pa = a.calcularPromedio();
                double pb = b.calcularPromedio();
                if (Math.abs(pa - pb) > Beca.TOLERANCIA) {
                    return Double.compare(pb, pa); 
                }
                return a.getCodigo().compareTo(b.getCodigo()); 
            }
        });
        return ranking;
    }

    // ---------- 4. Asignación ----------

   
    public int asignarBecas() {
        List<Estudiante> ranking = obtenerRankingElegibles();
        if (ranking.isEmpty()) {
            throw new IllegalStateException("No hay estudiantes elegibles para asignar becas.");
        }
        beca.reiniciarAsignacion();
        for (Estudiante e : ranking) {
            if (!beca.hayCupo()) {
                break;
            }
            beca.agregarBeneficiario(e);
        }
        asignacionRealizada = true;
        return beca.cuposOcupados();
    }

    public void configurarCupo(int nuevoCupo) {
        beca.setCupoMaximo(nuevoCupo);
        invalidarAsignacion();
    }

    private void invalidarAsignacion() {
        if (asignacionRealizada) {
            beca.reiniciarAsignacion();
            asignacionRealizada = false;
        }
    }

    // ---------- 5. Explicaciones ----------

    public String explicarEstudiante(String codigo) {
        Estudiante e = buscarEstudiante(codigo);
        if (e == null) {
            throw new IllegalStateException("No existe un estudiante con el código " + codigo + ".");
        }
        StringBuilder sb = new StringBuilder();
        sb.append(e.getCodigo()).append(" - ").append(e.getNombre()).append("\n");

        if (!e.tieneEvaluaciones()) {
            sb.append("NO ELEGIBLE: no tiene evaluaciones registradas.");
            return sb.toString();
        }
        double prom = e.calcularPromedio();
        sb.append(String.format("Promedio: %.2f (mínimo requerido: %.2f)%n", prom, beca.getNotaMinima()));

        if (!beca.esElegible(e)) {
            sb.append(String.format("NO ELEGIBLE: le faltan %.2f puntos para llegar al mínimo.",
                    beca.getNotaMinima() - prom));
            return sb.toString();
        }

        List<Estudiante> ranking = obtenerRankingElegibles();
        int posicion = ranking.indexOf(e) + 1;
        sb.append("ELEGIBLE. Posición en el ranking: ").append(posicion)
          .append(" de ").append(ranking.size()).append(".\n");

        if (!asignacionRealizada) {
            sb.append("Estado: pendiente, aún no se ha ejecutado la asignación de becas.");
        } else if (beca.esBeneficiario(e)) {
            sb.append("BECA ASIGNADA: su posición (").append(posicion)
              .append(") está dentro del cupo de ").append(beca.getCupoMaximo()).append(".");
        } else {
            sb.append("RECHAZADO POR CUPO: su posición (").append(posicion)
              .append(") supera el cupo de ").append(beca.getCupoMaximo()).append(".");
        }
        return sb.toString();
    }

    public String generarInformeAsignacion() {
        if (!asignacionRealizada) {
            return "Aún no se ha ejecutado la asignación de becas.";
        }
        List<Estudiante> ranking = obtenerRankingElegibles();
        StringBuilder sb = new StringBuilder();
        sb.append(beca).append("\n");
        sb.append("--- Beneficiarios ---\n");
        for (Estudiante e : beca.getBeneficiarios()) {
            sb.append(String.format("  [ASIGNADA] %s - %s | promedio %.2f%n",
                    e.getCodigo(), e.getNombre(), e.calcularPromedio()));
        }
        sb.append("--- Elegibles rechazados por cupo ---\n");
        boolean hayRechazados = false;
        for (Estudiante e : ranking) {
            if (!beca.esBeneficiario(e)) {
                hayRechazados = true;
                sb.append(String.format("  [SIN CUPO] %s - %s | promedio %.2f%n",
                        e.getCodigo(), e.getNombre(), e.calcularPromedio()));
            }
        }
        if (!hayRechazados) {
            sb.append("  (ninguno)\n");
        }
        sb.append("--- No elegibles ---\n");
        boolean hayNoElegibles = false;
        for (Estudiante e : estudiantes) {
            if (!beca.esElegible(e)) {
                hayNoElegibles = true;
                sb.append(String.format("  [NO ELEGIBLE] %s - %s | promedio %.2f%n",
                        e.getCodigo(), e.getNombre(), e.calcularPromedio()));
            }
        }
        if (!hayNoElegibles) {
            sb.append("  (ninguno)\n");
        }
        return sb.toString();
    }

   
    public void cargarDatosDemo() {
        String[][] datos = {
            {"E001", "Ana Torres", "9.5", "9.0"},
            {"E002", "Bruno Salazar", "9.0", "9.5"},
            {"E003", "Carla Mena", "8.5", "8.5"},
            {"E004", "Diego Paz", "7.0", "8.0"}
        };
        for (String[] d : datos) {
            if (buscarEstudiante(d[0]) == null) {
                registrarEstudiante(d[0], d[1]);
                registrarEvaluacion(d[0], "Parcial 1", Double.parseDouble(d[2]));
                registrarEvaluacion(d[0], "Parcial 2", Double.parseDouble(d[3]));
            }
        }
    }
}
